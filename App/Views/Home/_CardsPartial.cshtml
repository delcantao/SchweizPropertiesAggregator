@using System.Globalization
@model List<Data.Entities.Property>
 
<div class="space-y-4">
    <div class="flex items-center justify-between gap-3">
        <div>
            <p class="text-4xl font-semibold tracking-tight text-slate-900">@Model.Count imoveis</p>
            <p class="mt-2 text-lg text-slate-600">para alugar na area exibida no mapa</p>
        </div>

        <div
            class="hidden rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-sm font-semibold text-slate-800 shadow-sm lg:inline-flex">
            Mais relevantes
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-5 py-10 text-center text-slate-500">
            <p class="text-base font-semibold text-slate-700">Nenhum imovel encontrado</p>
            <p class="mt-2 text-sm">Mova o mapa para outra regiao para carregar novos cards.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 2xl:grid-cols-3">
            @foreach (var item in Model)
            {
                var photos = item.Images;
                var carouselId = $"carousel-{item.Id}";
                <a href="https://www.comparis.ch/immobilien/marktplatz/details/show/@item.Id" target="_blank">
                <article
                    data-property-id="@item.Id"
                    class="group property-card overflow-hidden rounded-[1.75rem] border border-stone-200 bg-white shadow-[0_10px_30px_rgba(15,23,42,0.05)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)]">
                    <div class="relative aspect-[1.3/1] bg-stone-100" id="@carouselId" data-index="0">
                        <div class="absolute inset-0 overflow-hidden" style="position: initial;">
                            @foreach (var photo in photos)
                            {
                                <img src="@photo" alt="@item.Title" loading="lazy"
                                     class="carousel-slide absolute inset-0 h-full w-full object-cover transition-opacity duration-500 opacity-0" />
                            }
                            @* <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-slate-950/70 via-slate-950/10 to-transparent px-4 py-4"> *@
                            @*     <div class="flex flex-wrap gap-2"> *@
                            @*         <span class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-800">Exclusivo </span> *@
                            @*         <span class="inline-flex rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-700">Em breve</span> *@
                            @*     </div> *@
                            @* </div> *@
                        </div>
                        @if (photos.Count > 1)
                        {
                            <button type="button" onclick="event.preventDefault(); carouselPrev('@carouselId')"
                                class="absolute  left-2 top-1/2 -translate-y-1/2 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-xl font-bold text-slate-800 shadow-md hover:bg-white transition">
                                ‹
                            </button>
                            <button type="button" onclick="event.preventDefault(); carouselNext('@carouselId')"
                                class="absolute right-2 top-1/2 -translate-y-1/2 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/90 text-xl font-bold text-slate-800 shadow-md hover:bg-white transition">
                                ›
                            </button>
                            <div class="absolute bottom-3 inset-x-0 flex justify-center gap-1.5 z-20">
                                @for (int d = 0; d < photos.Count; d++)
                                {
                                    <span class="carousel-dot block h-1.5 w-1.5 rounded-full bg-white/60 transition" data-i="@d"></span>
                                }
                            </div>
                        }
                    </div>

                    <div class="space-y-4 p-5">
                        <div class="space-y-3">
                            <p class="line-clamp-2 text-sm leading-6 text-slate-600">@item.Title</p>
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="text-4xl font-semibold tracking-tight text-slate-900">
                                        
                                        @if (item.Price == 0)
                                        {
                                            <span>Auf Anfrage</span>
                                        }
                                        else
                                        {
                                            <span>
                                            CHF
                                            @item.Price.ToString("N0", new CultureInfo("de-CH"))
                                            </span>
                                            
                                        }
                                    </p>
                                    <p class="mt-1 text-lg text-slate-500">@item.DealtypeNavigation.Description</p>
                                </div>
                                <button
                                    class="mt-1 inline-flex h-11 w-11 items-center justify-center rounded-full border border-stone-200 text-slate-500 transition hover:border-slate-400 hover:text-slate-900">
                                    <span aria-hidden="true">♡</span>
                                </button>
                            </div>
                        </div>

                        <div class="text-sm font-semibold text-slate-800">
                            @item.Area m² · @item.Bedrooms quartos · 1 vaga
                        </div>

                        <div class="text-sm leading-6 text-slate-500">
                            @item.Address  <br/> <strong>@item.City</strong>
                        </div>
                    </div>
                </article>
                </a>
                    }
                </div>
            }
        </div>

<script> 
    document.querySelectorAll('[id^="carousel-"]').forEach(el => carouselInit(el.id));
</script>

