@model List<Data.Entities.Property>

<div class="space-y-4">
    <div class="flex items-center justify-between gap-3">
        <div>
            <p class="text-4xl font-semibold tracking-tight text-slate-900">@Model.Count imoveis</p>
            <p class="mt-2 text-lg text-slate-600">para alugar na area exibida no mapa</p>
        </div>

        <div
            class="hidden rounded-full border border-stone-200 bg-stone-50 px-4 py-3 text-sm font-semibold text-slate-800 shadow-sm lg:inline-flex">
            Mais relevantes
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white px-5 py-10 text-center text-slate-500">
            <p class="text-base font-semibold text-slate-700">Nenhum imovel encontrado</p>
            <p class="mt-2 text-sm">Mova o mapa para outra regiao para carregar novos cards.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 2xl:grid-cols-3">
            @foreach (var item in Model)
            {
                <article
                    class="group overflow-hidden rounded-[1.75rem] border border-stone-200 bg-white shadow-[0_10px_30px_rgba(15,23,42,0.05)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_40px_rgba(15,23,42,0.12)]">
                    <div class="relative aspect-[1.3/1] overflow-hidden bg-stone-100">
                        <img src="@item.Images" alt="@item.Title" loading="lazy"
                             class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
                        <div
                            class="absolute inset-x-0 bottom-0 bg-linear-to-t from-slate-950/70 via-slate-950/10 to-transparent px-4 py-4">
                            <div class="flex flex-wrap gap-2">
                                <span
                                class="inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-800">Exclusivo</span>
                                <span
                                    class="inline-flex rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-slate-700">Em
                                    breve</span>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-4 p-5">
                            <div class="space-y-3">
                                <p class="line-clamp-2 text-sm leading-6 text-slate-600">@item.Title</p>
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <p class="text-4xl font-semibold tracking-tight text-slate-900">R$
                                            @item.Price.ToString("N0")</p>
                                            <p class="mt-1 text-lg text-slate-500">aluguel</p>
                                        </div>
                                        <button
                                            class="mt-1 inline-flex h-11 w-11 items-center justify-center rounded-full border border-stone-200 text-slate-500 transition hover:border-slate-400 hover:text-slate-900">
                                            <span aria-hidden="true">♡</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="text-sm font-semibold text-slate-800">
                                    51 m² · 2 quartos · 1 vaga
                                </div>

                                <div class="text-sm leading-6 text-slate-500">
                                    Rua Sao Nestor, Vila Mazzei · Sao Paulo
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>